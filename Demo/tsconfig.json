{
  "compilerOptions": {
    /* Standards de langage */
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],

    /* Résolution de modules (Mode Bundler moderne) */
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    /* Qualité et Strictesse */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,

    /* Émission déléguée à esbuild */
    "noEmit": true,
    "outDir": "./wwwroot/js"
  },
  "include": ["ClientApp/**/*.ts"]
}