{
  "compilerOptions": {
    /* Standards de langage */
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],

    /* Résolution de modules moderne */
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    
    /* Strictesse et Qualité */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,

    /* Sortie et Émission */
    "outDir": "./wwwroot/js",
    "noEmit": true, // Recommandé si vous utilisez un bundler externe
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["wwwroot/ts/**/*.ts"]
}