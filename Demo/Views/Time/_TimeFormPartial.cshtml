@model Demo.Models.TimeFormViewModel

<div class="time-form-container" data-min-limit="@Model.StartDate" data-range="@Model.RangeDays">

    <div class="time-nav-wrapper mb-3">
        <div class="time-nav-grid shadow-sm">
            <button type="button" id="btn-decrement-start" class="btn btn-sm btn-outline-primary btn-nav">
                <i class="bi bi-dash-lg me-1"></i> <span>Reculer</span>
            </button>

            <select id="stepUnit" class="form-select form-select-sm fw-bold shadow-none">
                <option value="7">7 jours</option>
                <option value="30" selected>30 jours</option>
                <option value="90">90 jours</option>
                <option value="365">1 an</option>
            </select>

            <button type="button" id="btn-increment-end" class="btn btn-sm btn-outline-primary btn-nav">
                <span>Avancer</span> <i class="bi bi-plus-lg ms-1"></i>
            </button>
        </div>
    </div>

    <div class="time-inputs-grid shadow-sm">
        <div class="row g-2 align-items-end">
            <div class="col-6 col-md-3">
                <label class="label-micro">Début</label>
                <input type="date" asp-for="StartDate" id="input-start" class="form-control form-control-sm rounded-0" />
            </div>
            <div class="col-6 col-md-3">
                <label class="label-micro">Fin</label>
                <input type="date" asp-for="EndDate" id="input-end" class="form-control form-control-sm rounded-0" />
            </div>
            
            <div class="col-12 col-md-6 mt-2 mt-md-0">
                <div class="d-flex gap-1">
                    <button type="button" id="btn-reset" class="btn btn-sm btn-outline-secondary px-3 fw-bold rounded-0">
                        <i class="bi bi-arrow-counterclockwise"></i> RESET
                    </button>
                    <button type="button" id="btn-apply-filter" class="btn btn-sm btn-primary flex-grow-1 fw-bold rounded-0">
                        <i class="bi bi-check2-circle me-1"></i>APPLIQUER
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>