@model TimeSelectorViewModel

@{
    ViewData["Title"] = "Analyse Temporelle";
}

@* Styles spécifiques au mode formulaire responsive *@
<link href="~/css/time-selector-responsive.css" rel="stylesheet" />

@* Conteneur Root : Cible pour ClientApp/time-form/main.ts *@
<div id="time-form-app" 
     data-start="@Model.StartDate" 
     data-end="@Model.EndDate" 
     data-points='@Model.JsonData'
     data-range="@Model.RangeDays" 
     class="container mt-3">

    <div class="accordion shadow-sm mb-4" id="timeSelectionAccordion">
        <div class="accordion-item shadow-none border-0">
            <h2 class="accordion-header" id="headingTime">
                @* Utilisation de d-flex pour centrer la période entre l'icône et le chevron *@
                <button class="accordion-button fw-bold d-flex align-items-center" type="button" 
                        data-bs-toggle="collapse" data-bs-target="#collapseTime" aria-expanded="true">
                    
                    <i class="bi bi-calendar3 text-primary"></i>
                    
                    @* Ce div occupe tout l'espace central et centre son contenu *@
                    <div class="flex-grow-1 text-center px-2">
                        <span class="d-none d-sm-inline text-muted fw-normal">Période : </span>
                        @* Mis à jour dynamiquement par main.ts via l'ID display-range *@
                        <strong class="ms-1 text-dark" id="display-range">
                            @DateTime.Parse(Model.StartDate).ToString("dd MMM yyyy") - 
                            @DateTime.Parse(Model.EndDate).ToString("dd MMM yyyy")
                        </strong>
                    </div>

                </button>
            </h2>

            <div id="collapseTime" class="accordion-collapse collapse show" data-bs-parent="#timeSelectionAccordion">
                <div class="accordion-body bg-light border-top">
                    @* Interface avec inputs date et boutons +/- *@
                    <div id="form-interface">
                        <partial name="_TimeSelectorPartial" model="Model" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Zone Graphique *@
    <div class="card shadow-sm border-0">
        <div class="card-body p-2 p-md-4">
            <div class="chart-container" style="position: relative; height: 400px; width: 100%;">
                @* Le loader est masqué par le ChartManager une fois les données traitées *@
                <div id="app-loader" class="spinner-wrapper">
                    <div class="custom-spinner"></div>
                </div>
                <canvas id="chart"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* 1. Bibliothèque Chart.js (chargée avant le module) *@
    <script src="~/lib/chartjs/chart.umd.js"></script>

    @* 2. Logique du formulaire (esbuild) *@
    <script type="module" src="~/js/time-form/main.js" asp-append-version="true"></script>
}