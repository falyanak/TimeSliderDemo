@{
    ViewData["Title"] = "Time Slider Demo";
}
<!-- CSS noUiSlider -->
<link href="~/lib/nouislider/nouislider.css" rel="stylesheet" />

<h2>@ViewData["Title"]</h2>

<!-- Sliders -->
<div id="masterSlider" style="margin: 20px 0;"></div>
<div id="detailSlider" style="margin: 20px 0;"></div>
<div id="output" style="margin: 10px 0; font-weight: bold;"></div>
<canvas id="chart" width="800" height="300"></canvas>

<!-- Chart.js -->
<script src="~/lib/chartjs/chart.umd.js"></script>

<!-- Données pour le slider -->
<script>
    const START = "2020-01-01";
    const END = "2025-12-31";
    const DATA = [];

    let d = new Date(START);
    const end = new Date(END);
    while(d <= end){
        DATA.push({ t: d.toISOString().substring(0,10), v: Math.floor(Math.random()*100) });
        d.setUTCDate(d.getUTCDate()+1);
    }
</script>

<!-- Ton bundle TypeScript compilé -->
<script type="module" src="~/js/main.js" asp-append-version="true"></script>
