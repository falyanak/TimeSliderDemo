@model TimeSliderViewModel

@{
    ViewData["Title"] = "Analyse Temporelle";
}

<link href="~/lib/nouislider/nouislider.css" rel="stylesheet" />
<link href="~/css/slider.css" rel="stylesheet" />
<link href="~/css/spinner.css" rel="stylesheet" />

<div id="time-slider-app" 
     data-start="@Model.StartDate" 
     data-end="@Model.EndDate" 
     data-range="@Model.RangeDays"
     data-points='@Model.JsonData'
     class="container mt-4">

    <h2>@ViewData["Title"]</h2>

    <input type="hidden" id="filter-start" name="startDate" value="@Model.StartDate" />
    <input type="hidden" id="filter-end" name="endDate" value="@Model.EndDate" />

    <div class="chart-container" style="position: relative;">
        <div id="app-loader" class="spinner-wrapper">
            <div class="custom-spinner"></div>
        </div>
        <canvas id="chart"></canvas>
    </div>

    <div class="sliders-section">
        <div class="mb-4">
            <small class="text-muted d-block mb-1">Vue d'ensemble (Master)</small>
            <div id="masterSlider"></div>
        </div>

        <div class="mb-4">
            <small class="text-muted d-block mb-1">Fenêtre de précision (Détail)</small>
            <div id="detailSlider"></div>
        </div>
    </div>
    
    <div class="d-flex justify-content-between align-items-center mt-5 pt-3 border-top">
        <div id="output" class="small text-secondary">
            Initialisation de la période...
        </div>
        
        <button type="button" id="btn-apply-filter" class="btn btn-primary px-4 shadow-sm">
            Appliquer le filtre
        </button>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.js"></script>
    <script type="module" src="~/js/main.js" asp-append-version="true"></script>
}