@model Demo.Models.TimeSliderViewModel

<div class="time-slider-container" data-range="@Model.RangeDays">
    
    <div class="time-nav-wrapper mb-4">
        <div class="time-nav-grid shadow-sm">
            <button type="button" id="btn-prev-period" class="btn btn-sm btn-outline-primary btn-nav">
                <i class="bi bi-chevron-left"></i> <span>Précédent</span>
            </button>

            <div class="px-3 fw-bold text-primary small">Navigation</div>

            <button type="button" id="btn-next-period" class="btn btn-sm btn-outline-primary btn-nav">
                <span>Suivant</span> <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </div>

    <div class="px-3 pb-4">
        <div id="time-slider" class="mt-2"></div>
        <div class="d-flex justify-content-between mt-3">
            <span class="badge bg-light text-dark border" id="slider-start-label">--/--/--</span>
            <span class="badge bg-primary" id="slider-duration-label">@Model.RangeDays jours</span>
            <span class="badge bg-light text-dark border" id="slider-end-label">--/--/--</span>
        </div>
    </div>

    <div class="text-center mt-2">
        <button type="button" id="btn-reset-slider" class="btn btn-sm btn-link text-muted text-decoration-none">
            <i class="bi bi-arrow-counterclockwise"></i> Réinitialiser le slider
        </button>
    </div>
</div>